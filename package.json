  "version": "0.0.3",
  "publisher": "UltraKostik",
  "icon": "images/marketplace-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/UltraKostik/vscode-menthol-theme.git"
  },
  "bugs": {
    "url": "https://github.com/UltraKostik/vscode-menthol-theme/issues"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "mint",
    "menthol",
    "dark",
    "minimal",
    "modern",
    "fresh",
    "cool",
    "semantic-highlighting"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Menthol Theme",
        "uiTheme": "vs-dark",
        "path": "./themes/menthol-theme-color-theme.json"
      },
      {
        "label": "Menthol Theme Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/menthol-theme-dark-color-theme.json"
