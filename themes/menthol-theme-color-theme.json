	"semanticTokenColors": {
		"enabled": true,
		"variable": { "foreground": "#E6EDF3" },
		"variable.parameter": { "foreground": "#E0B090" },
		"variable.arguments": { "foreground": "#E8C860" },
		"variable.constant": { "foreground": "#7AD0A0" },
		"variable.defaultLibrary": { "foreground": "#70C8E0" },
		"variable.global": { "foreground": "#E6EDF3" },
		"variable.readonly": { "fontStyle": "normal" },
		"variable.declaration": { "fontStyle": "bold" },
		"variable.decorator": { "foreground": "#E0A0B8", "fontStyle": "bold" },
		"variable.classMember": { "foreground": "#E8D080" },
		"variable.dynamicAttribute": { "foreground": "#70C8E0" },
		"variable.callable": { "fontStyle": "bold" },
		"variable.readonly.callable": { "fontStyle": "bold" },
		"variable.import": { "foreground": "#6AB8B8" },
		"variable.export": { "foreground": "#6AB8B8" },
		"variable.reference": { "fontStyle": "italic" },
		"variable.pointer": { "foreground": "#E6EDF3" },
		"variable:dart": { "foreground": "#E0B090" },
		"annotation:dart": { "foreground": "#E0B090" },
		"property:dart": { "foreground": "#E0B090" },

		"decorator": { "foreground": "#E0A0B8", "fontStyle": "bold" },
		"decorator.builtin": { "foreground": "#E0A0B8", "fontStyle": "bold" },

		"function": { "foreground": "#70C8E0" },
		"function.defaultLibrary": { "foreground": "#70C8E0" },
		"function.declaration": { "fontStyle": "normal" },
		"function.parameter": { "foreground": "#E0B090" },
		"function.return": { "foreground": "#D4A0E0", "fontStyle": "italic" },
		"function.async": { "foreground": "#7AC8E8" },
		"function.const": { "fontStyle": "normal" },
		"function.package": { "foreground": "#E8D080" },

		"method": { "foreground": "#70C8E0" },
		"method.defaultLibrary": { "foreground": "#70C8E0" },
		"method.declaration": { "fontStyle": "normal" },
		"method.static": { "fontStyle": "bold" },
		"method.abstract": { "fontStyle": "normal" },
		"method.const": { "fontStyle": "normal" },

		"class": { "foreground": "#E8D080" },
		"class.declaration": { "fontStyle": "bold" },
		"class.builtin": { "foreground": "#E8D080", "fontStyle": "bold" },
		"class.modification": { "fontStyle": "normal" },
		"class.abstract": { "fontStyle": "normal" },
		"class.final": { "fontStyle": "bold" },
		"class.error": { "foreground": "#E07070", "fontStyle": "bold" },
		"class.exception": { "foreground": "#E07070", "fontStyle": "bold" },
		"class.decorator": { "foreground": "#E0A0B8", "fontStyle": "bold" },

		"interface": { "foreground": "#E8D080" },
		"interface.declaration": { "fontStyle": "bold" },
		"interface.builtin": { "foreground": "#E8D080", "fontStyle": "bold" },
		"interface.abstract": { "fontStyle": "normal" },

		"enum": { "foreground": "#E8D080" },
		"enum.declaration": { "fontStyle": "bold" },
		"enum.builtin": { "foreground": "#E8D080", "fontStyle": "bold" },
		"enumMember": { "foreground": "#4AAA8A" },

		"type": { "foreground": "#D4A0E0", "fontStyle": "italic" },
		"type.parameter": { "foreground": "#D4A0E0", "fontStyle": "italic" },
		"type.declaration": { "fontStyle": "bold" },
		"type.builtin": { "foreground": "#D4A0E0", "fontStyle": "italic" },
		"type.defaultLibrary": { "foreground": "#D4A0E0", "fontStyle": "italic" },
		"type.generic": { "foreground": "#D4A0E0", "fontStyle": "italic" },
		"type.interface": { "foreground": "#E8D080", "fontStyle": "italic" },

		"property": { "foreground": "#E6EDF3" },
		"property.declaration": { "fontStyle": "bold" },
		"property.static": { "fontStyle": "bold" },
		"property.readonly": { "fontStyle": "normal" },

		"namespace": { "foreground": "#E8D080" },
		"namespace.declaration": { "fontStyle": "bold" },

		"macro": { "foreground": "#E0B090" },
		"macro.unsafe": { "foreground": "#E07070", "fontStyle": "bold" },
		"event": { "foreground": "#E0B090" },
		"operator": { "foreground": "#6AA8A8" },
		"operator.overloaded": { "foreground": "#E0B090", "fontStyle": "bold" },
		"label": { "foreground": "#6ABA8A" },
		"parameter": { "foreground": "#E0B090" },
		"parameter.readonly": { "fontStyle": "normal" },
		"typeParameter": { "foreground": "#D4A0E0", "fontStyle": "italic" },
		"member": { "foreground": "#E6EDF3" },
		"variable.property": { "foreground": "#E6EDF3" },
		"function.method": { "foreground": "#70C8E0" },
		"function.constructor": { "foreground": "#E8D080" },
		"function.special": { "foreground": "#E8D080" },
		"function.unsafe": { "foreground": "#E07070", "fontStyle": "bold" },
		"newOperator": { "foreground": "#7A8AC8", "fontStyle": "italic" },
		"stringLiteral": { "foreground": "#7AD0A0" },
		"numberLiteral": { "foreground": "#E0B090" },
		"boolean": { "foreground": "#E0B090", "fontStyle": "normal" },
		"tomlArrayKey": { "foreground": "#E8C860" },
		"*.deprecated": { "fontStyle": "strikethrough" },
		"*.abstract": { "fontStyle": "italic" },
		"*.static": { "fontStyle": "bold" },
		"operator.unsafe": { "foreground": "#E07070", "fontStyle": "bold" },
		"method.unsafe": { "foreground": "#E07070", "fontStyle": "bold" }
