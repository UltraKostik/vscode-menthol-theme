{
	"name": "Menthol Theme",
	"colors": {
		"editor.background": "#0D1117",
		"editor.foreground": "#E6EDF3",
		"activityBar.background": "#161B22",
		"sideBar.background": "#0D1117",
		"statusBar.background": "#161B22",
		"titleBar.activeBackground": "#0D1117",
		
		"activityBarBadge.background": "#3A9A7A",
		"activityBarBadge.foreground": "#0D1117",
		"button.background": "#3A9A7A",
		"button.hoverBackground": "#4AAA8A",
		"focusBorder": "#4AAA8A",
		"progressBar.background": "#4AAA8A",
		
		"activityBar.foreground": "#70C8E0",
		"sideBarTitle.foreground": "#70C8E0",
		"editorLineNumber.foreground": "#2D4048",
		"editorLineNumber.activeForeground": "#70C8E0",
		
		"editor.selectionBackground": "#1A3A3A",
		"editor.wordHighlightBackground": "#152A2A",
		"editorBracketHighlight.foreground1": "#4AAA8A",
		"editorBracketHighlight.foreground2": "#70C8E0",
		"editorBracketHighlight.foreground3": "#90D4B0",
		
		"scrollbarSlider.background": "#1F2A3A",
		"scrollbarSlider.hoverBackground": "#2A3A4A",
		"panel.background": "#0D1117",
		"terminal.background": "#0D1117",
		"terminal.foreground": "#E6EDF3",
		"editorGroupHeader.tabsBackground": "#161B22",
		"tab.activeBackground": "#0D1117",
		"tab.inactiveBackground": "#161B22"
	},
	"semanticTokenColors": {
		"variable": { "foreground": "#E6EDF3" },
		"variable.parameter": { "foreground": "#E0B090" },
		"variable.arguments": { "foreground": "#E8C860" },
		"variable.constant": { "foreground": "#7AD0A0" },
		"variable.defaultLibrary": { "foreground": "#70C8E0" },
		"variable.global": { "foreground": "#E6EDF3" },

		"function": { "foreground": "#70C8E0" },
		"function.defaultLibrary": { "foreground": "#70C8E0" },

		"method": { "foreground": "#70C8E0" },
		"method.defaultLibrary": { "foreground": "#70C8E0" },

		"class": { "foreground": "#E8D080" },
		"interface": { "foreground": "#E8D080" },
		"enum": { "foreground": "#E8D080" },
		"enumMember": { "foreground": "#4AAA8A" },

		"type": { "foreground": "#D4A0E0", "fontStyle": "italic" },
		"type.parameter": { "foreground": "#D4A0E0", "fontStyle": "italic" },

		"property": { "foreground": "#E6EDF3" },
		"namespace": { "foreground": "#E8D080" },
		"decorator": { "foreground": "#E0A0B8", "fontStyle": "bold" },
		"macro": { "foreground": "#E0B090" }
	},
	"tokenColors": [
		{
			"name": "Comment",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#5A9A7A",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Keyword, Storage",
			"scope": ["keyword", "storage.type", "storage.modifier"],
			"settings": {
				"foreground": "#4AAA8A"
			}
		},
		{
			"name": "Type",
			"scope": ["storage.type", "keyword.other.type.php"],
			"settings": {
				"foreground": "#5AAAB8"
			}
		},
		{
			"name": "Modifier",
			"scope": "storage.modifier",
			"settings": {
				"foreground": "#6ABA8A"
			}
		},
		{
			"name": "Function, Special Method",
			"scope": ["entity.name.function", "meta.function-call", "variable.function", "support.function", "keyword.other.special-method"],
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "String, Symbols",
			"scope": ["string", "constant.other.symbol", "constant.other.key", "markup.heading"],
			"settings": {
				"foreground": "#7AD0A0"
			}
		},
		{
			"name": "Number, Constant",
			"scope": ["constant.numeric", "constant.language", "support.constant", "constant.character", "constant.escape", "variable.parameter"],
			"settings": {
				"foreground": "#E0B090"
			}
		},
		{
			"name": "Arguments",
			"scope": ["meta.function-call.arguments", "meta.function-call.js variable.other.readwrite.js", "meta.function-call.arguments.python"],
			"settings": {
				"foreground": "#E8C860"
			}
		},
		{
			"name": "Class, Support",
			"scope": ["entity.name", "support.type", "support.class", "entity.name.class"],
			"settings": {
				"foreground": "#E8D080"
			}
		},
		{
			"name": "Tag",
			"scope": ["entity.name.tag", "meta.tag.sgml"],
			"settings": {
				"foreground": "#4AAA8A"
			}
		},
		{
			"name": "Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "Operator, Misc",
			"scope": ["keyword.control", "punctuation", "meta.tag", "punctuation.definition.tag"],
			"settings": {
				"foreground": "#6AA8A8"
			}
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.assignment", "string constant.other.placeholder"],
			"settings": {
				"foreground": "#E6EDF3"
			}
		},
		{	"name": "Decorators",
			"scope": ["entity.name.function.decorator", "meta.function.decorator", "punctuation.definition.decorator"],
			"settings": {
				"foreground": "#E0A0B8",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Invalid",
			"scope": ["invalid", "invalid.illegal"],
			"settings": {
				"foreground": "#E06060"
			}
		},
		{
			"name": "Regular Expressions",
			"scope": ["string.regexp"],
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "URL",
			"scope": ["*url*", "*link*", "*uri*"],
			"settings": {
				"fontStyle": "underline",
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "Markdown Strong",
			"scope": ["markup.bold"],
			"settings": {
				"foreground": "#E8D080",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown Emphasis",
			"scope": ["markup.italic"],
			"settings": {
				"foreground": "#7AD0A0",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown Link",
			"scope": ["string.other.link.title.markdown"],
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "JSON Keys (все уровни)",
			"scope": ["support.type.property-name.json"],
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "CSS Properties",
			"scope": ["support.type.property-name"],
			"settings": {
				"foreground": "#E8D080"
			}
		},
        {
            "name": "CSS Selectors",
            "scope": ["entity.other.attribute-name.class", "entity.other.attribute-name.id", "entity.name.tag.css"],
            "settings": {
                "foreground": "#7AD0A0"
            }
        },
        {
            "name": "CSS Units",
            "scope": "keyword.other.unit.css",
            "settings": {
                "foreground": "#E0B090"
            }
        },
        {
            "name": "CSS Pseudoclasses/elements",
            "scope": ["entity.other.attribute-name.pseudo-class.css", "entity.other.attribute-name.pseudo-element.css"],
            "settings": {
                "foreground": "#6AA8A8",
                "fontStyle": "italic"
            }
        },
        {
            "name": "CSS Colors",
            "scope": "support.constant.color.w3c-standard-color-name.css",
            "settings": {
                "foreground": "#D4A0E0"
            }
        },
		{
			"name": "Type Annotations",
			"scope": ["support.type", "constant.language", "meta.type.annotation"],
			"settings": {
				"foreground": "#D4A0E0",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Exceptions",
			"scope": ["support.type.exception"],
			"settings": {
				"foreground": "#E07070",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Self (this)",
			"scope": ["variable.parameter.function.language.special.self.python", "variable.language.special.self.python", "variable.language.this"],
			"settings": {
				"foreground": "#8A8AD8",
				"fontStyle": "italic"
			}
		},
		{
			"name": "New (New object)",
			"scope": ["keyword.control.new", "keyword.operator.new"],
			"settings": {
				"foreground": "#7A8AC8",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Magic methods",
			"scope": "support.function.magic",
			"settings": {
				"foreground": "#70C8E0",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown Headings",
			"scope": "markup.heading",
			"settings": {
				"foreground": "#E8D080",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown Bold",
			"scope": "markup.bold.markdown",
			"settings": {
				"foreground": "#E8D080",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown Italic",
			"scope": "markup.italic.markdown",
			"settings": {
				"foreground": "#7AD0A0",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown Bold Italic",
			"scope": "markup.bold.markdown markup.italic.markdown",
			"settings": {
				"foreground": "#E0A0B8",
				"fontStyle": "italic bold"
			}
		},
		{
			"name": "Markdown Link",
			"scope": "markup.underline.link.markdown",
			"settings": {
				"foreground": "#70C8E0",
				"fontStyle": "underline"
			}
		},
		{
			"name": "Markdown Blockquote",
			"scope": "markup.quote.markdown",
			"settings": {
				"foreground": "#6AA8A8",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown Fenced Code Block",
			"scope": "markup.fenced_code.block.markdown",
			"settings": {
				"foreground": "#E6EDF3",
				"background": "#161B22"
			}
		},
		{
			"name": "Markdown List",
			"scope": "markup.list.markdown",
			"settings": {
				"foreground": "#4AAA8A"
			}
		},
        {
            "name": "Inline CSS properties",
            "scope": "meta.embedded.line.css support.type.property-name.css",
            "settings": {
                "foreground": "#E8D080"
            }
        },
        {
            "name": "Inline CSS values",
            "scope": "meta.embedded.line.css support.constant.property-value.css",
            "settings": {
                "foreground": "#7AD0A0"
            }
        }
	]
}