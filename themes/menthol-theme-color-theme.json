	"tokenColors": [
		{
			"name": "Comment",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#5A9A7A",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Double-Slashed Comment",
			"scope": "comment.line.double-slash",
			"settings": {
				"foreground": "#5A9A7A",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Keyword, Storage",
			"scope": ["keyword", "storage.type", "storage.modifier"],
			"settings": {
				"foreground": "#4AAA8A"
			}
		},
		{
			"name": "Type",
			"scope": ["support.type", "entity.name.type", "keyword.other.type.php"],
			"settings": {
				"foreground": "#5AAAB8"
			}
		},
		{
			"name": "Modifier",
			"scope": "storage.modifier",
			"settings": {
				"foreground": "#6ABA8A"
			}
		},
		{
			"name": "Function, Special Method",
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"variable.function",
				"support.function",
				"keyword.other.special-method"
			],
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "Go function keyword",
			"scope": "keyword.function.go",
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "JavaScript function keyword",
			"scope": "storage.type.function.js",
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "Lua function keyword",
			"scope": "keyword.control.lua",
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "PHP function keyword",
			"scope": "storage.type.function.php",
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "C++ function definition",
			"scope": "meta.function.c,meta.function.cpp",
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "C# function definition",
			"scope": "entity.name.function.cs",
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "Java function definition",
			"scope": "entity.name.function.java",
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "GraphQL field",
			"scope": "entity.name.field.graphql",
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "GraphQL argument",
			"scope": "variable.argument.graphql",
			"settings": {
				"foreground": "#E0B090"
			}
		},
		{
			"name": "Prisma model",
			"scope": "entity.name.model.prisma",
			"settings": {
				"foreground": "#E8D080"
			}
		},
		{
			"name": "Prisma field",
			"scope": "entity.name.field.prisma",
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "Import",
			"scope": [
				"keyword.control.import",
				"keyword.control.import.ts",
				"keyword.control.import.swift",
				"keyword.control.import.js",
				"keyword.control.import.go",
				"keyword.other.import.dart",
				"keyword.control.at-rule.import.css",
				"storage.modifier.import",
				"storage.modifier.import.java",
				"keyword.control.export"
			],
			"settings": {
				"foreground": "#6AB8B8"
			}
		},
		{
			"name": "Python from import",
			"scope": "keyword.control.import.from.python",
			"settings": {
				"foreground": "#6AB8B8"
			}
		},
		{
			"name": "Python as import",
			"scope": "keyword.control.import.as.python",
			"settings": {
				"foreground": "#6AB8B8"
			}
		},
		{
			"name": "C/C++ include",
			"scope": [
				"keyword.control.directive.include.c",
				"keyword.control.directive.include.cpp",
				"keyword.control.import.include.php"
			],
			"settings": {
				"foreground": "#6AB8B8"
			}
		},
		{
			"name": "Ruby require",
			"scope": "keyword.other.special-method.ruby",
			"settings": {
				"foreground": "#6AB8B8"
			}
		},
		{
			"name": "String, Symbols",
			"scope": ["string", "constant.other.symbol", "constant.other.key", "markup.heading"],
			"settings": {
				"foreground": "#7AD0A0"
			}
		},
		{
			"name": "Number, Constant",
			"scope": ["constant.numeric", "constant.language", "support.constant", "constant.character", "constant.escape", "variable.parameter"],
			"settings": {
				"foreground": "#E0B090",
				"fontStyle": "normal"
			}
		},
		{
			"name": "Arguments",
			"scope": [
				"meta.function-call.arguments",
				"meta.function-call.arguments.python",
				"meta.function-call.js variable.other.readwrite.js",
				"meta.argument.shell"
			],
			"settings": {
				"foreground": "#E8C860"
			}
		},
		{
			"name": "Class, Support",
			"scope": ["entity.name", "support.type", "support.class", "entity.name.class"],
			"settings": {
				"foreground": "#E8D080"
			}
		},
		{
			"name": "Tag",
			"scope": ["entity.name.tag", "meta.tag.sgml"],
			"settings": {
				"foreground": "#4AAA8A"
			}
		},
		{
			"name": "Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#70C8E0"
			}
		},
		{
			"name": "Operator, Misc",
			"scope": ["keyword.control", "punctuation", "meta.tag", "punctuation.definition.tag"],
			"settings": {
				"foreground": "#6AA8A8",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.assignment", "string constant.other.placeholder"],
			"settings": {
				"foreground": "#E6EDF3"
			}
		},
		{
			"name": "Decorators (fallback)",
			"scope": ["meta.decorator", "entity.name.function.decorator"],
			"settings": {
				"foreground": "#E0A0B8",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Python decorator @",
