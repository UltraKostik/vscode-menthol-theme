{
	"name": "Menthol Theme",
	"colors": {
		"editor.background": "#0D1117",
		"editor.foreground": "#E6EDF3",
		"activityBar.background": "#161B22",
		"sideBar.background": "#0D1117",
		"statusBar.background": "#161B22",
		"titleBar.activeBackground": "#0D1117",
		
		"activityBarBadge.background": "#00D2A0",
		"activityBarBadge.foreground": "#0D1117",
		"button.background": "#00D2A0",
		"button.hoverBackground": "#00E6B3",
		"focusBorder": "#00D2A0",
		"progressBar.background": "#00E6B3",
		
		"activityBar.foreground": "#66E0FF",
		"sideBarTitle.foreground": "#66E0FF",
		"editorLineNumber.foreground": "#2D3748",
		"editorLineNumber.activeForeground": "#66E0FF",
		
		"editor.selectionBackground": "#1A3A3A",
		"editor.wordHighlightBackground": "#152A2A",
		"editorBracketHighlight.foreground1": "#00D2A0",
		"editorBracketHighlight.foreground2": "#66E0FF",
		"editorBracketHighlight.foreground3": "#A8E6CF",
		
		"scrollbarSlider.background": "#1F2A3A",
		"scrollbarSlider.hoverBackground": "#2A3A4A",
		"panel.background": "#0D1117",
		"terminal.background": "#0D1117",
		"terminal.foreground": "#E6EDF3",
		"editorGroupHeader.tabsBackground": "#161B22",
		"tab.activeBackground": "#0D1117",
		"tab.inactiveBackground": "#161B22"
	},
	"semanticTokenColors": {
		"variable": { "foreground": "#ffffff"},
		"variable.parameter": { "foreground": "#F57C3A"},
		"variable.arguments": {"foreground": "#f5dc3a"},
		"variable.constant": { "foreground": "#4ECDC4" },
		"variable.defaultLibrary": { "foreground": "#66E0FF" },
		"variable.global": { "foreground": "#ffffff" },

		"function": { "foreground": "#66E0FF" },
		"function.defaultLibrary": { "foreground": "#66E0FF" },

		"method": { "foreground": "#66E0FF" },
		"method.defaultLibrary": { "foreground": "#66E0FF" },

		"class": { "foreground": "#FFD93D" },

		"type": { "foreground": "#D47AF8", "fontStyle": "italic" },
		"type.parameter": { "foreground": "#D47AF8", "fontStyle": "italic" },

		"interface": { "foreground": "#FFD93D" },

		"enum": { "foreground": "#FFD93D" },
		"enumMember": { "foreground": "#00D2A0" },

		"property": { "foreground": "#E6EDF3" },
		"namespace": { "foreground": "#FFD93D" },
		"decorator": { "foreground": "#d676be", "fontStyle": "bold" },
		"macro": { "foreground": "#F57C3A" }
	},
	"tokenColors": [
		{
			"name": "Comment",
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": {
				"foreground": "#70FFB5",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Keyword, Storage",
			"scope": ["keyword", "storage.type", "storage.modifier"],
			"settings": {
				"foreground": "#00D2A0"
			}
		},
		{
			"name": "Function, Special Method",
			"scope": ["entity.name.function", "meta.function-call", "variable.function", "support.function", "keyword.other.special-method"],
			"settings": {
				"foreground": "#66E0FF"
			}
		},
		{
			"name": "String, Symbols",
			"scope": ["string", "constant.other.symbol", "constant.other.key", "markup.heading"],
			"settings": {
				"foreground": "#A8E6CF",
			}
		},
		{
			"name": "Number, Constant",
			"scope": ["constant.numeric", "constant.language", "support.constant", "constant.character", "constant.escape", "variable.parameter"],
			"settings": {
				"foreground": "#F57C3A"
			}
		},
		{
			"name": "Arguments",
			"scope": ["meta.function-call.arguments", "meta.function-call.js variable.other.readwrite.js", "meta.function-call.arguments.python"],
			"settings": {
				"foreground": "#f5dc3a",
			}
		},
		{
			"name": "Class, Support",
			"scope": ["entity.name", "support.type", "support.class", "entity.name.class"],
			"settings": {
				"foreground": "#FFD93D"
			}
		},
		{
			"name": "Tag",
			"scope": ["entity.name.tag", "meta.tag.sgml"],
			"settings": {
				"foreground": "#00D2A0"
			}
		},
		{
			"name": "Attributes",
			"scope": ["entity.other.attribute-name"],
			"settings": {
				"foreground": "#66E0FF"
			}
		},
		{
			"name": "Operator, Misc",
			"scope": ["keyword.control", "punctuation", "meta.tag", "punctuation.definition.tag"],
			"settings": {
				"foreground": "#89DDFF"
			}
		},
		{
			"name": "Variables",
			"scope": ["variable", "variable.assignment", "string constant.other.placeholder"],
			"settings": {
				"foreground": "#ffffff"
			}
		},
		{	"name": "Decorators",
			"scope": ["entity.name.function.decorator", "meta.function.decorator", "punctuation.definition.decorator"],
			"settings": {
				"foreground": "#d676be",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Invalid",
			"scope": ["invalid", "invalid.illegal"],
			"settings": {
				"foreground": "#FF1744"
			}
		},
		{
			"name": "Regular Expressions",
			"scope": ["string.regexp"],
			"settings": {
				"foreground": "#66E0FF"
			}
		},
		{
			"name": "URL",
			"scope": ["*url*", "*link*", "*uri*"],
			"settings": {
				"fontStyle": "underline",
				"foreground": "#66E0FF"
			}
		},
		{
			"name": "Markdown - Heading",
			"scope": ["markdown.heading", "markup.heading"],
			"settings": {
				"foreground": "#00D2A0",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown - Strong",
			"scope": ["markup.bold"],
			"settings": {
				"foreground": "#FFD93D",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown - Emphasis",
			"scope": ["markup.italic"],
			"settings": {
				"foreground": "#A8E6CF",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown - Link",
			"scope": ["string.other.link.title.markdown"],
			"settings": {
				"foreground": "#66E0FF"
			}
		},
		{
			"name": "JSON Keys (все уровни)",
			"scope": ["support.type.property-name.json"],
			"settings": {
				"foreground": "#66E0FF"
			}
		},
		{
			"name": "CSS Properties",
			"scope": ["support.type.property-name"],
			"settings": {
				"foreground": "#FFD93D"
			}
		},
		{
			"name": "CSS Selectors",
			"scope": ["entity.other.attribute-name.class", "entity.other.attribute-name.id"],
			"settings": {
				"foreground": "#A8E6CF"
			}
		},
		{
			"name": "Type Annotations",
			"scope": ["support.type", "constant.language", "meta.type.annotation"],
			"settings": {
				"foreground": "#D47AF8",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Exceptions",
			"scope": ["support.type.exception"],
			"settings": {
				"foreground": "#F87474",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Self (this)",
			"scope": ["variable.parameter.function.language.special.self.python", "variable.language.special.self.python", "variable.language.this"],
			"settings": {
				"foreground": "#6f83f1",
				"fontStyle": "italic"
			},
		},
		{
			"name": "New (New object)",
			"scope": ["keyword.control.new", "keyword.operator.new"],
			"settings": {
				"foreground": "#4570ff",
				"fontStyle": "italic"
			}
		}
	]
}